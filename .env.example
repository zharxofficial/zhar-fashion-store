# Copy to .env.local for local development. On Vercel, add the SAME names under Project > Settings > Environment Variables.
# NEVER commit real values. None of these start with VITE_, so none are ever shipped to the browser.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
# SECRET: server only. Supabase > Project Settings > API > service_role. Never paste it in chat, code or the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"
# Your live site address (used in confirmation / password-reset emails), e.g. https://zhar.vercel.app
APP_URL="http://localhost:3000"
